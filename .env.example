# ==============================================================================
# CodeGrogu Portfolio — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - NEVER commit .env, .env.local, or secrets into version control.
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the client browser.
# - All other variables are server-only secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Neon Serverless PostgreSQL Database (Required for Full-Stack Systems)
# ------------------------------------------------------------------------------
# Neon connection string with SSL enabled
DATABASE_URL=postgresql://neondb_owner:npg_placeholder@ep-solitary-river-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. Resend Email Notifications (Required for Booking & Contact System)
# ------------------------------------------------------------------------------
# Resend API Key for sending transactional confirmation emails
RESEND_API_KEY=re_1234567890abcdefghijklmnopqrstuv
RESEND_FROM_EMAIL=CodeGrogu <noreply@codegrogu.com>

# ------------------------------------------------------------------------------
# 4. Upstash Redis (Required for API Rate Limiting & Abuse Prevention)
# ------------------------------------------------------------------------------
# Upstash REST endpoint and authorization token
UPSTASH_REDIS_REST_URL=https://upstash-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX_placeholder_token_for_rate_limiting

# ------------------------------------------------------------------------------
# 5. PostHog Telemetry & Analytics (Optional in Local Dev, Recommended in Prod)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_placeholder_public_key_12345
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
